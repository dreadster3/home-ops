{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": ["Custom versioning for termix"],
      "matchDatasources": ["docker"],
      "versioning": "regex:^(?:release\\-)?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\-tag)?$",
      "matchPackagePatterns": ["termix"]
    }
  ]
}
